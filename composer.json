{
  "name": "ultimate-multisite/omni-platform-newsletter",
  "description": "Write-once WordPress newsletters for responsive web, email, and duplex print/PDF output.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "newsletter",
    "nonprofit",
    "email",
    "print",
    "pdf"
  ],
  "authors": [
    {
      "name": "Ultimate Multisite Community",
      "homepage": "https://ultimatemultisite.com"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13"
  },
  "homepage": "https://github.com/Ultimate-Multisite/omni-platform-newsletter",
  "support": {
    "issues": "https://github.com/Ultimate-Multisite/omni-platform-newsletter/issues",
    "source": "https://github.com/Ultimate-Multisite/omni-platform-newsletter"
  },
  "archive": {
    "exclude": [
      "/.aidevops.json",
      "/.github",
      "/.gitattributes",
      "/.gitignore",
      "/AGENTS.md",
      "/composer.lock",
      "/phpcs.xml",
      "/tests"
    ]
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.2.0"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "for f in omni-platform-newsletter.php web-template.php includes/*.php views/*.php tests/*.php; do php -l \"$f\" || exit 1; done",
    "lint:js": "node --check overflow.js && node --check assets/editor.js",
    "phpcs": "phpcs",
    "test:contract": "php tests/plugin-contract-test.php",
    "test": [
      "@lint:php",
      "@lint:js",
      "@phpcs",
      "@test:contract"
    ]
  }
}
